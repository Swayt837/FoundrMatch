# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=cofound_db

# --- Security ---
# Required unless ENVIRONMENT=development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# development | staging | production
ENVIRONMENT=development
# Comma-separated origins allowed to call the API. "*" is accepted for local
# development only — credentialed requests are disabled while it is set.
ALLOWED_ORIGINS=*
# Set to false to disable request rate limiting (tests, load benchmarks).
RATE_LIMIT_ENABLED=true

# Password given to the eight demo founders that seed_profiles.py creates.
# Required by that script, unused by the API itself. There is no default: the
# script lives in a public repository, so a hardcoded value would be a published
# credential the moment the backend is reachable. Re-running the script rotates
# the password on accounts that already exist.
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
SEED_PASSWORD=

# --- Object storage for profile photos (Cloudflare R2) ---
# Without these the API answers 503 on /api/uploads/photo and the app falls back
# to storing images inline as base64 — which works, but puts every photo inside
# the user document and ships them in full with every discovery card.
#
# From the Cloudflare dashboard: R2 -> create a bucket, then Manage API Tokens ->
# Create token with Object Read & Write on it. The account id is in the R2
# overview page URL. R2_PUBLIC_BASE_URL is the public origin the bucket is served
# from: either the r2.dev domain Cloudflare gives you, or a custom one.
#
#   R2_PUBLIC_BASE_URL=https://cdn.example.com   (no trailing slash)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Google Sign-In ---
# The OAuth client IDs this backend accepts an ID token for, comma-separated.
# Google stamps each token with the client that requested it, and the app has one
# client per platform, so list all of them — iOS, Android and Web. Create them at
# console.cloud.google.com → APIs & Services → Credentials.
#
# Leave empty and /api/auth/google/callback returns 503; email/password sign-in is
# unaffected. There is no client *secret* here: the app uses the PKCE flow, which
# does not need one, and a secret shipped in a mobile binary is not a secret.
GOOGLE_CLIENT_IDS=

# --- AI (Claude) ---
# From console.anthropic.com. Without it the app still works: compatibility scoring
# is local and deterministic (see backend/compatibility.py). What goes dark is the
# "why you two" narrative, the premium deep report, business ideas and the copilot.
ANTHROPIC_API_KEY=
# Overridable so the model can change without a deploy.
LLM_MODEL=claude-opus-5

# --- Free tier quotas ---
FREE_DAILY_SWIPES=10
FREE_MAX_MATCHES=5
# Candidates ranked per discovery request. Scoring is local, so this is bounded by
# the Mongo read, not by compute.
DISCOVERY_CANDIDATE_POOL=500

# --- Video calls (WebRTC) ---
# Calls are peer-to-peer: the audio and video never reach this backend, which only
# relays signalling over Socket.io. What the peers need from us is how to be reached.
#
# STUN lets a peer discover its own public address. Free and stateless; the defaults
# are Google's public servers. Override to avoid depending on them.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
#
# TURN *relays* the media when no direct path can be established — symmetric NAT,
# carrier-grade NAT, restrictive corporate firewalls. Roughly 10-20% of real calls
# need it, and it cannot be free because it carries the bytes. Until all three are
# set, /api/calls/config reports relay_configured=false and the call screen warns the
# user that calls may not connect on some networks. Any standard TURN service works
# (coturn, Twilio, Cloudflare, Metered).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Payments (Stripe) ---
# Stripe covers the web checkout only. Purchases made inside the iOS and Android
# apps must go through StoreKit / Play Billing, so they never reach this code path.

# REQUIRED for the webhook. Without it the endpoint refuses every event rather
# than trusting an unsigned payload. Get it from the Stripe dashboard, or from
# `stripe listen --forward-to localhost:8001/api/webhook/stripe`.
STRIPE_WEBHOOK_SECRET=

# The monthly plan is a real Stripe subscription, which needs a Price object and a
# real secret key. Until both are set, /api/premium/plans reports monthly as
# unavailable and the paywall hides it — better than selling a "monthly" plan that
# charges once and never renews.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=

# Prices, so they can change without a deploy. NOTE: the PRD quotes premium at
# ~EUR 20/month; these defaults preserve the current USD values instead of
# silently repricing the product.
PREMIUM_CURRENCY=usd
PREMIUM_LIFETIME_AMOUNT=29.00
PREMIUM_MONTHLY_AMOUNT=9.99
