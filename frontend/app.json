{
  "expo": {
    "name": "CoFound",
    "slug": "cofound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cofound",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cofound.app",
      "bitcode": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.cofound.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CoFound needs access to your photos so you can add pictures to your founder profile.",
          "cameraPermission": "CoFound uses your camera for video calls with founders you have matched with, and to take your profile photo.",
          "microphonePermission": "CoFound uses your microphone so you can be heard during audio and video calls with founders you have matched with."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "CoFound uses your camera for video calls with founders you have matched with, and to take your profile photo.",
          "microphonePermission": "CoFound uses your microphone so you can be heard during audio and video calls with founders you have matched with."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f42074c8-1600-4408-90ad-aa24a895ed52"
      }
    },
    "owner": "flo837"
  }
}
