# Copy to frontend/.env and fill in. Never commit the real .env.

# Base URL of the backend, without a trailing slash and without /api.
# The API client appends /api itself, and the Socket.io client connects to this
# same origin.
#
#   Web / simulator on the same machine .. http://localhost:8001
#   Physical device (Expo Go or a dev
#   build) ............................... http://<your-LAN-IP>:8001
#
# `localhost` on a phone means the phone itself, so a device build must use the
# machine's LAN address — find it with `ipconfig getifaddr en0` (macOS) or
# `hostname -I` (Linux). For EAS builds, set it per profile in eas.json instead.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# --- Google Sign-In (optional) ---
# One OAuth client per platform, from console.cloud.google.com → APIs & Services →
# Credentials. Leave them empty and the "Continue with Google" button is hidden;
# email/password sign-up still works.
#
# These are public by design — the app uses PKCE, which has no client secret. The
# backend independently verifies every token against Google, so a client ID here is
# not a credential. The matching list of IDs goes in the backend's GOOGLE_CLIENT_IDS.
#
# Two extra steps that are easy to miss, and that fail at runtime rather than at
# build time if skipped:
#
#   iOS     — the *reversed* iOS client ID must be registered as a URL scheme, or
#             Google has nowhere to send the user back to. Add it to app.json under
#             `expo.ios.infoPlist.CFBundleURLTypes`, then `yarn prebuild` and check
#             it landed:
#               "CFBundleURLTypes": [
#                 { "CFBundleURLSchemes": ["com.googleusercontent.apps.<IOS_ID>"] }
#               ]
#             (<IOS_ID> is the client ID with the .apps.googleusercontent.com
#             suffix removed.)
#
#   Android — the OAuth client is bound to the signing certificate's SHA-1. For an
#             EAS build that comes from `eas credentials`, not from your machine's
#             debug keystore; using the local one works in development and then
#             fails in the released build.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
