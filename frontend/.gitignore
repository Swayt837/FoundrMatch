# dependencies
node_modules/

# Expo
.expo/
.metro-cache/
dist/
web-build/
expo-env.d.ts

# Native
# ios/ and android/ are generated by `expo prebuild` from app.json (continuous
# native generation). Committing them would mean editing native projects by hand
# and losing the config-plugin pipeline — regenerate instead.
ios/
android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

